package __PACKAGE__;

import org.bukkit.Bukkit;
import org.bukkit.ChatColor;
import org.bukkit.Location;
import org.bukkit.Material;
import org.bukkit.World;
import org.bukkit.block.Block;
import org.bukkit.command.Command;
import org.bukkit.command.CommandExecutor;
import org.bukkit.command.PluginCommand;
import org.bukkit.command.CommandSender;
import org.bukkit.command.TabCompleter;
import org.bukkit.configuration.ConfigurationSection;
import org.bukkit.entity.Player;
import org.bukkit.event.EventHandler;
import org.bukkit.event.Listener;
import org.bukkit.event.entity.EntityDamageEvent;
import org.bukkit.event.inventory.InventoryClickEvent;
import org.bukkit.event.player.PlayerMoveEvent;
import org.bukkit.inventory.Inventory;
import org.bukkit.inventory.InventoryHolder;
import org.bukkit.inventory.ItemStack;
import org.bukkit.inventory.meta.ItemMeta;
import org.bukkit.plugin.java.JavaPlugin;
import org.bukkit.scheduler.BukkitTask;

import java.util.ArrayList;
import java.util.Collections;
import java.util.HashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.UUID;
import java.util.regex.Pattern;

public final class HomeMaster extends JavaPlugin implements Listener, CommandExecutor, TabCompleter {
    private static final String PREFIX = ChatColor.AQUA + "" + ChatColor.BOLD + "HomeMaster " + ChatColor.GRAY + "» " + ChatColor.RESET;
    private static final Pattern VALID_NAME = Pattern.compile("[A-Za-z0-9_-]{1,16}");
    private final Map<UUID, PendingTeleport> pending = new HashMap<>();
    private final Map<UUID, Long> cooldownUntil = new HashMap<>();
    private final Map<UUID, Location> previousLocations = new HashMap<>();

    @Override
    public void onEnable() {
        getConfig().addDefault("max-homes", 3);
        getConfig().addDefault("teleport-delay-seconds", 3);
        getConfig().addDefault("teleport-cooldown-seconds", 5);
        getConfig().addDefault("require-safe-location", true);
        getConfig().options().copyDefaults(true);
        saveConfig();

        registerCommand("sethome", getCommand("sethome"));
        registerCommand("home", getCommand("home"));
        registerCommand("delhome", getCommand("delhome"));
        registerCommand("homes", getCommand("homes"));
        registerCommand("renamehome", getCommand("renamehome"));
        registerCommand("back", getCommand("back"));
        getServer().getPluginManager().registerEvents(this, this);
        getLogger().info("HomeMaster Ultra aktiviert.");
    }

    private void registerCommand(String name, PluginCommand command) {
        if (command == null) {
            getLogger().warning("Command /" + name + " fehlt in plugin.yml.");
            return;
        }
        command.setExecutor(this);
        command.setTabCompleter(this);
    }

    @Override
    public void onDisable() {
        for (PendingTeleport value : pending.values()) {
            if (value.task != null) value.task.cancel();
        }
        pending.clear();
        saveConfig();
    }

    @Override
    public boolean onCommand(CommandSender sender, Command command, String label, String[] args) {
        if (!(sender instanceof Player player)) {
            sender.sendMessage("Dieser Befehl ist nur im Spiel verfügbar.");
            return true;
        }
        String name = command.getName().toLowerCase(Locale.ROOT);
        switch (name) {
            case "sethome" -> setHome(player, args);
            case "home" -> goHome(player, args);
            case "delhome" -> deleteHome(player, args);
            case "homes" -> listHomes(player, args);
            case "renamehome" -> renameHome(player, args);
            case "back" -> goBack(player);
            default -> player.sendMessage(PREFIX + ChatColor.RED + "Unbekannter Befehl.");
        }
        return true;
    }

    private void setHome(Player player, String[] args) {
        if (!allowed(player, "homemaster.sethome")) return;
        String name = args.length == 0 ? "home" : cleanName(args[0]);
        if (name == null) {
            player.sendMessage(PREFIX + ChatColor.RED + "Name: 1–16 Zeichen, nur Buchstaben, Zahlen, _ und -.");
            return;
        }
        String base = homesPath(player);
        ConfigurationSection homes = getConfig().getConfigurationSection(base);
        boolean replacing = homes != null && homes.isConfigurationSection(name);
        int count = homes == null ? 0 : homes.getKeys(false).size();
        if (!replacing && count >= maxHomes(player)) {
            player.sendMessage(PREFIX + ChatColor.RED + "Du hast dein Home-Limit erreicht (" + maxHomes(player) + ").");
            return;
        }
        saveLocation(base + "." + name, player.getLocation());
        saveConfig();
        player.sendMessage(PREFIX + ChatColor.GREEN + "Home " + ChatColor.WHITE + name + ChatColor.GREEN + " gespeichert.");
    }

    private void goHome(Player player, String[] args) {
        if (!allowed(player, "homemaster.home")) return;
        String name = args.length == 0 ? "home" : cleanName(args[0]);
        if (name == null) {
            player.sendMessage(PREFIX + ChatColor.RED + "Ungültiger Home-Name.");
            return;
        }
        Location target = loadLocation(homesPath(player) + "." + name);
        if (target == null) {
            player.sendMessage(PREFIX + ChatColor.RED + "Home " + name + " existiert nicht oder seine Welt ist nicht geladen.");
            return;
        }
        beginTeleport(player, target);
    }

    private void deleteHome(Player player, String[] args) {
        if (!allowed(player, "homemaster.delhome")) return;
        if (args.length != 1) {
            player.sendMessage(PREFIX + ChatColor.YELLOW + "Verwendung: /delhome <Name>");
            return;
        }
        String name = cleanName(args[0]);
        String path = name == null ? "" : homesPath(player) + "." + name;
        if (name == null || !getConfig().isConfigurationSection(path)) {
            player.sendMessage(PREFIX + ChatColor.RED + "Dieses Home existiert nicht.");
            return;
        }
        getConfig().set(path, null);
        saveConfig();
        player.sendMessage(PREFIX + ChatColor.GREEN + "Home " + name + " gelöscht.");
    }

    private void listHomes(Player player, String[] args) {
        if (!allowed(player, "homemaster.homes")) return;
        if (args.length > 0 && args[0].equalsIgnoreCase("gui")) {
            openHomeMenu(player, 0);
            return;
        }
        ConfigurationSection section = getConfig().getConfigurationSection(homesPath(player));
        if (section == null || section.getKeys(false).isEmpty()) {
            player.sendMessage(PREFIX + ChatColor.GRAY + "Du hast noch keine Homes. Nutze /sethome.");
            return;
        }
        player.sendMessage(PREFIX + ChatColor.AQUA + "Deine Homes (" + section.getKeys(false).size() + "):");
        List<String> names = new ArrayList<>(section.getKeys(false));
        Collections.sort(names, String.CASE_INSENSITIVE_ORDER);
        for (String home : names) {
            Location location = loadLocation(homesPath(player) + "." + home);
            if (location != null) {
                player.sendMessage(ChatColor.GRAY + "• " + ChatColor.WHITE + home + ChatColor.GRAY + " – "
                        + location.getWorld().getName() + " " + location.getBlockX() + ", "
                        + location.getBlockY() + ", " + location.getBlockZ());
            }
        }
        player.sendMessage(ChatColor.GRAY + "GUI: /homes gui");
    }

    private void renameHome(Player player, String[] args) {
        if (!allowed(player, "homemaster.renamehome")) return;
        if (args.length != 2) {
            player.sendMessage(PREFIX + ChatColor.YELLOW + "Verwendung: /renamehome <Alt> <Neu>");
            return;
        }
        String oldName = cleanName(args[0]);
        String newName = cleanName(args[1]);
        String base = homesPath(player);
        if (oldName == null || newName == null || !getConfig().isConfigurationSection(base + "." + oldName)) {
            player.sendMessage(PREFIX + ChatColor.RED + "Altes Home nicht gefunden oder ein Name ist ungültig.");
            return;
        }
        if (getConfig().isConfigurationSection(base + "." + newName)) {
            player.sendMessage(PREFIX + ChatColor.RED + "Ein Home mit diesem Namen existiert bereits.");
            return;
        }
        ConfigurationSection old = getConfig().getConfigurationSection(base + "." + oldName);
        if (old == null) return;
        for (String key : old.getKeys(false)) {
            getConfig().set(base + "." + newName + "." + key, old.get(key));
        }
        getConfig().set(base + "." + oldName, null);
        saveConfig();
        player.sendMessage(PREFIX + ChatColor.GREEN + "Home umbenannt: " + oldName + " → " + newName);
    }

    private void goBack(Player player) {
        if (!allowed(player, "homemaster.back")) return;
        Location location = previousLocations.get(player.getUniqueId());
        if (location == null || location.getWorld() == null) {
            player.sendMessage(PREFIX + ChatColor.RED + "Es gibt noch keine vorherige Position.");
            return;
        }
        beginTeleport(player, location);
    }

    private void beginTeleport(Player player, Location requestedTarget) {
        UUID uuid = player.getUniqueId();
        if (pending.containsKey(uuid)) {
            player.sendMessage(PREFIX + ChatColor.RED + "Teleport bereits vorgemerkt. Bewege dich zum Abbrechen.");
            return;
        }
        long now = System.currentTimeMillis();
        if (!player.hasPermission("homemaster.bypass.cooldown")) {
            long until = cooldownUntil.getOrDefault(uuid, 0L);
            if (until > now) {
                player.sendMessage(PREFIX + ChatColor.RED + "Warte noch " + Math.max(1, (until - now + 999) / 1000) + " s.");
                return;
            }
        }
        Location target = getConfig().getBoolean("require-safe-location", true) ? safeLocation(requestedTarget) : requestedTarget.clone();
        if (target == null || target.getWorld() == null) {
            player.sendMessage(PREFIX + ChatColor.RED + "Kein sicherer Zielort gefunden.");
            return;
        }
        int seconds = player.hasPermission("homemaster.bypass.delay") ? 0 : Math.max(0, getConfig().getInt("teleport-delay-seconds", 3));
        if (seconds == 0) {
            finishTeleport(player, target);
            return;
        }
        PendingTeleport state = new PendingTeleport(player.getLocation().clone(), target, seconds);
        pending.put(uuid, state);
        player.sendMessage(PREFIX + ChatColor.YELLOW + "Teleport in " + seconds + " Sekunden. Nicht bewegen oder Schaden nehmen.");
        state.task = Bukkit.getScheduler().runTaskTimer(this, () -> {
            if (!player.isOnline() || !pending.containsKey(uuid)) {
                cancelTeleport(uuid, false);
                return;
            }
            if (state.remaining <= 0) {
                pending.remove(uuid);
                if (state.task != null) state.task.cancel();
                finishTeleport(player, target);
                return;
            }
            player.sendMessage(PREFIX + ChatColor.GRAY + "Teleport in " + state.remaining + "…");
            state.remaining--;
        }, 20L, 20L);
    }

    private void finishTeleport(Player player, Location target) {
        if (target.getWorld() == null) {
            player.sendMessage(PREFIX + ChatColor.RED + "Die Zielwelt ist nicht verfügbar.");
            return;
        }
        previousLocations.put(player.getUniqueId(), player.getLocation().clone());
        boolean success = player.teleport(target);
        if (success) {
            int cooldown = Math.max(0, getConfig().getInt("teleport-cooldown-seconds", 5));
            if (cooldown > 0 && !player.hasPermission("homemaster.bypass.cooldown")) {
                cooldownUntil.put(player.getUniqueId(), System.currentTimeMillis() + cooldown * 1000L);
            }
            player.sendMessage(PREFIX + ChatColor.GREEN + "Teleport abgeschlossen.");
        } else {
            player.sendMessage(PREFIX + ChatColor.RED + "Teleport fehlgeschlagen.");
        }
    }

    private void cancelTeleport(UUID uuid, boolean tellPlayer) {
        PendingTeleport state = pending.remove(uuid);
        if (state == null) return;
        if (state.task != null) state.task.cancel();
        Player player = Bukkit.getPlayer(uuid);
        if (tellPlayer && player != null) player.sendMessage(PREFIX + ChatColor.RED + "Teleport abgebrochen.");
    }

    @EventHandler
    public void onMove(PlayerMoveEvent event) {
        if (event.getTo() == null) return;
        PendingTeleport state = pending.get(event.getPlayer().getUniqueId());
        if (state == null) return;
        Location from = event.getFrom();
        Location to = event.getTo();
        if (from.getBlockX() != to.getBlockX() || from.getBlockY() != to.getBlockY() || from.getBlockZ() != to.getBlockZ()) {
            cancelTeleport(event.getPlayer().getUniqueId(), true);
        }
    }

    @EventHandler
    public void onDamage(EntityDamageEvent event) {
        if (event.getEntity() instanceof Player player && pending.containsKey(player.getUniqueId())) {
            cancelTeleport(player.getUniqueId(), true);
        }
    }

    @EventHandler
    public void onMenuClick(InventoryClickEvent event) {
        if (!(event.getView().getTopInventory().getHolder() instanceof HomeMenuHolder holder)) return;
        event.setCancelled(true);
        if (!(event.getWhoClicked() instanceof Player player) || !player.getUniqueId().equals(holder.owner)) return;
        int slot = event.getRawSlot();
        if (slot < 0 || slot >= event.getView().getTopInventory().getSize()) return;
        if (slot == 45 && holder.page > 0) {
            openHomeMenu(player, holder.page - 1);
            return;
        }
        if (slot == 53) {
            openHomeMenu(player, holder.page + 1);
            return;
        }
        String home = holder.homeBySlot.get(slot);
        if (home == null) return;
        Location location = loadLocation(homesPath(player) + "." + home);
        player.closeInventory();
        if (location == null) {
            player.sendMessage(PREFIX + ChatColor.RED + "Dieses Home ist nicht verfügbar.");
        } else {
            beginTeleport(player, location);
        }
    }

    private void openHomeMenu(Player player, int requestedPage) {
        if (!allowed(player, "homemaster.gui")) return;
        ConfigurationSection section = getConfig().getConfigurationSection(homesPath(player));
        List<String> names = section == null ? new ArrayList<>() : new ArrayList<>(section.getKeys(false));
        Collections.sort(names, String.CASE_INSENSITIVE_ORDER);
        int maxPage = Math.max(0, (names.size() - 1) / 45);
        int page = Math.max(0, Math.min(requestedPage, maxPage));
        HomeMenuHolder holder = new HomeMenuHolder(player.getUniqueId(), page);
        Inventory inventory = Bukkit.createInventory(holder, 54, ChatColor.DARK_AQUA + "Deine Homes · Seite " + (page + 1));
        holder.inventory = inventory;
        for (int slot = 0; slot < 45; slot++) {
            int index = page * 45 + slot;
            if (index >= names.size()) break;
            String name = names.get(index);
            Location loc = loadLocation(homesPath(player) + "." + name);
            ItemStack item = new ItemStack(loc == null ? Material.BARRIER : Material.ENDER_PEARL);
            ItemMeta meta = item.getItemMeta();
            if (meta != null) {
                meta.setDisplayName(ChatColor.AQUA + name);
                List<String> lore = new ArrayList<>();
                if (loc != null) {
                    lore.add(ChatColor.GRAY + loc.getWorld().getName());
                    lore.add(ChatColor.GRAY + loc.getBlockX() + ", " + loc.getBlockY() + ", " + loc.getBlockZ());
                    lore.add(ChatColor.GREEN + "Klicken zum Teleportieren");
                } else {
                    lore.add(ChatColor.RED + "Zielwelt nicht verfügbar");
                }
                meta.setLore(lore);
                item.setItemMeta(meta);
            }
            inventory.setItem(slot, item);
            holder.homeBySlot.put(slot, name);
        }
        if (page > 0) inventory.setItem(45, menuItem(Material.ARROW, ChatColor.YELLOW + "Vorherige Seite"));
        inventory.setItem(49, menuItem(Material.BOOK, ChatColor.GRAY + names.size() + " Homes"));
        if (page < maxPage) inventory.setItem(53, menuItem(Material.ARROW, ChatColor.YELLOW + "Nächste Seite"));
        player.openInventory(inventory);
    }

    private ItemStack menuItem(Material material, String title) {
        ItemStack item = new ItemStack(material);
        ItemMeta meta = item.getItemMeta();
        if (meta != null) {
            meta.setDisplayName(title);
            item.setItemMeta(meta);
        }
        return item;
    }

    private Location safeLocation(Location requested) {
        World world = requested.getWorld();
        if (world == null) return null;
        int bx = requested.getBlockX();
        int by = requested.getBlockY();
        int bz = requested.getBlockZ();
        for (int dy = 0; dy <= 4; dy++) {
            for (int radius = 0; radius <= 2; radius++) {
                for (int dx = -radius; dx <= radius; dx++) {
                    for (int dz = -radius; dz <= radius; dz++) {
                        if (Math.abs(dx) != radius && Math.abs(dz) != radius && radius > 0) continue;
                        int x = bx + dx;
                        int y = by + dy;
                        int z = bz + dz;
                        Block feet = world.getBlockAt(x, y, z);
                        Block head = world.getBlockAt(x, y + 1, z);
                        Block floor = world.getBlockAt(x, y - 1, z);
                        if (feet.isPassable() && head.isPassable() && floor.getType().isSolid() && !floor.isLiquid()) {
                            return new Location(world, x + 0.5, y, z + 0.5, requested.getYaw(), requested.getPitch());
                        }
                    }
                }
            }
        }
        return null;
    }

    private void saveLocation(String path, Location location) {
        getConfig().set(path + ".world", location.getWorld().getName());
        getConfig().set(path + ".x", location.getX());
        getConfig().set(path + ".y", location.getY());
        getConfig().set(path + ".z", location.getZ());
        getConfig().set(path + ".yaw", location.getYaw());
        getConfig().set(path + ".pitch", location.getPitch());
    }

    private Location loadLocation(String path) {
        String worldName = getConfig().getString(path + ".world");
        World world = worldName == null ? null : Bukkit.getWorld(worldName);
        if (world == null || !getConfig().contains(path + ".x")) return null;
        return new Location(world, getConfig().getDouble(path + ".x"), getConfig().getDouble(path + ".y"),
                getConfig().getDouble(path + ".z"), (float) getConfig().getDouble(path + ".yaw"),
                (float) getConfig().getDouble(path + ".pitch"));
    }

    private String homesPath(Player player) {
        return "homes." + player.getUniqueId();
    }

    private int maxHomes(Player player) {
        if (player.hasPermission("homemaster.bypass.limit")) return 1000;
        int configured = Math.max(1, getConfig().getInt("max-homes", 3));
        for (int limit = 100; limit > configured; limit--) {
            if (player.hasPermission("homemaster.limit." + limit)) return limit;
        }
        return player.hasPermission("homemaster.multiple") ? configured : 1;
    }

    private boolean allowed(Player player, String permission) {
        if (player.hasPermission(permission) || player.hasPermission("homemaster.admin")) return true;
        player.sendMessage(PREFIX + ChatColor.RED + "Dafür fehlt dir die Permission: " + permission);
        return false;
    }

    private String cleanName(String raw) {
        if (raw == null || !VALID_NAME.matcher(raw).matches()) return null;
        return raw.toLowerCase(Locale.ROOT);
    }

    @Override
    public List<String> onTabComplete(CommandSender sender, Command command, String alias, String[] args) {
        if (!(sender instanceof Player player)) return Collections.emptyList();
        List<String> result = new ArrayList<>();
        String name = command.getName().toLowerCase(Locale.ROOT);
        if (args.length == 1 && (name.equals("home") || name.equals("delhome") || name.equals("renamehome"))) {
            ConfigurationSection section = getConfig().getConfigurationSection(homesPath(player));
            if (section != null) {
                for (String home : section.getKeys(false)) {
                    if (home.toLowerCase(Locale.ROOT).startsWith(args[0].toLowerCase(Locale.ROOT))) result.add(home);
                }
            }
            if (name.equals("home") && "home".startsWith(args[0].toLowerCase(Locale.ROOT))) result.add("home");
        } else if (name.equals("homes") && args.length == 1 && "gui".startsWith(args[0].toLowerCase(Locale.ROOT))) {
            result.add("gui");
        }
        Collections.sort(result);
        return result;
    }

    private static final class PendingTeleport {
        private final Location origin;
        private final Location target;
        private int remaining;
        private BukkitTask task;

        private PendingTeleport(Location origin, Location target, int remaining) {
            this.origin = origin;
            this.target = target;
            this.remaining = remaining;
        }
    }

    private static final class HomeMenuHolder implements InventoryHolder {
        private final UUID owner;
        private final int page;
        private final Map<Integer, String> homeBySlot = new HashMap<>();
        private Inventory inventory;

        private HomeMenuHolder(UUID owner, int page) {
            this.owner = owner;
            this.page = page;
        }

        @Override
        public Inventory getInventory() {
            return inventory;
        }
    }
}
